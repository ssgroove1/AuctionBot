SELECT * FROM movies;

SELECT  title, release_date
FROM movies
WHERE release_date > '2016';

SELECT  title, release_date
FROM movies
WHERE release_date > '2008' AND release_date < '2010';

-- сортировка от меньшего к большему
SELECT vote_average, title
FROM movies
ORDER BY vote_average;

-- сортировка в обратную сторону (от большего к меньшему)
SELECT vote_average, title
FROM movies
ORDER BY vote_average DESC;

SELECT * FROM movies
ORDER BY RANDOM()
LIMIT 1;

SELECT title, release_date FROM movies
WHERE release_date > '2008' AND release_date < '2010'
ORDER BY RANDOM()
LIMIT 3;

SELECT * FROM movies
WHERE budget > 30000000 AND director_id = 5417;

SELECT * FROM movies
WHERE release_date>2015 OR vote_average>8;

SELECT * FROM movies
WHERE NOT budget = 0;

SELECT * FROM movies
WHERE release_date BETWEEN '2015-01' AND '2015-02';

-- %: Заменяет любую последовательность символов (в том числе и пустую)
-- Выбор всех фильмов, название которых начинается с Harry Potter
SELECT * FROM movies
WHERE title LIKE 'Harry Potter%';

-- _: Заменяет один любой символ.
-- Выбор всех фильмов, в описании которых есть слово programmer
SELECT * FROM movies
WHERE tagline LIKE '%programmer%';

-- IN: Позволяет сравнивать значение с набором значений
-- Выбор фильмов с режиссерами из списка (Кристофер Нолан и Хаяо Миядзаки)
SELECT * FROM movies
WHERE director_id IN (4765, 5417);

-- IS NULL, IS NOT NULL: Проверяет наличие или отсутствие значения.
-- Выбор фильмов, у которых есть слоган
SELECT * FROM movies
WHERE tagline IS NOT NULL;

-- Возвращает 10 первых строк из таблицы movies
SELECT * FROM movies
LIMIT 10;

-- Возвращает 10 строк из таблицы movies начиная с 100
SELECT * FROM movies
LIMIT 10 OFFSET 100;

SELECT * FROM movies
ORDER BY popularity DESC
LIMIT 1;

SELECT * FROM movies
WHERE release_date BETWEEN '2009-11' AND '2010-1'
ORDER BY budget DESC
LIMIT 1;

SELECT * FROM movies
WHERE tagline LIKE 'The battle within.'
LIMIT 1;

SELECT * FROM movies
WHERE release_date < '1980' and vote_average > '8'
ORDER BY vote_count DESC;


SELECT genre_id, COUNT(*) 
FROM movies_genres
GROUP BY genre_id;

SELECT director_id, COUNT(*) 
FROM movies
GROUP BY director_id;

SELECT director_id, avg(budget) AS avg_budget
FROM movies
GROUP BY director_id
ORDER BY avg_budget DESC;

-- Возвращает таблицу с столбцами: название фильмов и имена режиссеров. Вывод реализован с помощью соединения двух таблиц: таблицы с фильмами и с режиссерами по полю director_id 
SELECT title, name AS director_name
FROM movies
INNER JOIN directors ON movies.director_id = directors.id;

-- Возвращает фильмы и жанры этих фильмов
SELECT title, genre
FROM movies
INNER JOIN movies_genres ON movies.id = movies_genres.movie_id
INNER JOIN genres ON movies_genres.genre_id = genres.genre_id;


select name AS director_name, MAX(release_date)
FROM movies
INNER JOIN directors ON movies.director_id = directors.id
GROUP BY director_name;

SELECT name AS director_name, SUM(budget) AS sum_budget
FROM movies
INNER JOIN directors ON movies.director_id = directors.id
GROUP BY director_name
ORDER BY sum_budget DESC;

select name AS director_name, COUNT(title) AS number_movies
FROM movies
INNER JOIN directors ON movies.director_id = directors.id
GROUP BY director_name
ORDER BY number_movies DESC;

select title, COUNT(genre_id) AS number_genres
FROM movies
INNER JOIN movies_genres ON movies.id = movies_genres.movie_id
GROUP BY title
ORDER BY number_genres DESC;

select name AS director_name, COUNT(genre_id) AS number_genres
FROM movies
INNER JOIN directors ON movies.director_id = directors.id
INNER JOIN movies_genres ON movies.id = movies_genres.movie_id
GROUP BY director_name
ORDER BY number_genres DESC;